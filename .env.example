# OTEL Log Generator Configuration

OTEL_SIGNAL=logs

CONCURRENCY=1

DRY_RUN=false

# Number of messages to send (default: 1)
MESSAGE_COUNT=10

# Minimum interval between started messages in milliseconds (default: 0)
MESSAGE_INTERVAL_MS=100

# Percentage of invalid records to generate 0-100 (default: 0.0)
# logs only: must be 0 when OTEL_SIGNAL=traces (otherwise startup fails)
INVALID_RECORD_PERCENT=0.0

# Number of records per message (default: 1)
RECORDS_PER_MESSAGE=1

# Number of ResourceLogs groups (distinct service pods) packed into one request (default: 1)
# Simulates OTEL Collector batching across services/pods. Clamped to <= RECORDS_PER_MESSAGE.
SERVICE_SHARDS_PER_MESSAGE=1

# Print detailed logs for each message (default: false)
PRINT_LOGS=false

# Run in continuous mode (default: false)
CONTINUOUS_MODE=false

# Retry configuration for rate limiting (HTTP 429 / gRPC ResourceExhausted)
# Maximum number of retry attempts (0-10, default: 3)
RETRY_MAX_RETRIES=3

# Base delay in milliseconds for exponential backoff (default: 1000)
RETRY_BASE_DELAY_MS=1000

# Maximum delay in milliseconds for exponential backoff (default: 32000)
RETRY_MAX_DELAY_MS=32000

# Ingest endpoint (required)
OTEL_LOGS_ENDPOINT=http://localhost:4318/v1/logs

### Vendor auth (applied to every HTTP/gRPC request, independent of tenant header)
# Raw OTLP headers: key=val,key2=val2  (e.g. Authorization=Bearer xxx, x-bt-parent=project_name:foo)
# OTEL_EXPORTER_OTLP_HEADERS=
# Shortcut: Bearer token -> Authorization: Bearer <token>
# OTEL_AUTH_BEARER=
# Shortcut: user:pass -> base64 -> Authorization: Basic <b64>
# OTEL_AUTH_BASIC=

# Health check endpoint (optional)
OTEL_HEALTHCHECK_ENDPOINT=http://localhost:13133/

# Use protobuf encoding (default: false)
OTEL_USE_PROTOBUF=false

# Transport type: http or grpc (default: http)
OTEL_TRANSPORT=http

# Label cardinality limiting (logs only; traces are not normalized in v1)
# Enable/disable limiting (default: true)
OTEL_LABEL_CARDINALITY_ENABLED=true

# Default limit for keys not listed below (optional)
# OTEL_LABEL_CARDINALITY_DEFAULT_LIMIT=32

# Per-key limits as CSV map key=limit,key2=limit2
# Safe defaults are applied automatically for:
# k8s.pod.name=32,host.name=16,service.version=32,request.id=64,thread.id=32,user.id=64
OTEL_LABEL_CARDINALITY_LIMITS=k8s.pod.name=32,host.name=16,service.version=32,request.id=64,thread.id=32,user.id=64

# Tenant routing
# Single-tenant mode defaults to "default".
TENANT_ID=default
# Multi-tenant mode switch. When > 1, routing uses tenant1..tenantN and ignores TENANT_ID.
TENANT_COUNT=1

# Number of cloud.account.id values generated inside each tenant-local pool (default: 4)
CLOUD_ACCOUNT_COUNT_PER_TENANT=4

# Number of service.name values generated inside each tenant-local pool (default: 6)
SERVICE_COUNT_PER_TENANT=6

# Per-batch jitter for log record timestamps in milliseconds; whole request shifts back by rand(0, value).
# Applied once per batch, not per record. (0 to disable, max 3600000, default: 1000 = 1s)
RECORD_ACROSS_BATCH_TIMESTAMP_JITTER_MS=1000
# Intra-batch forward step between adjacent records and size of rare backward nudge in nanoseconds.
# (0 to disable, max 60000000000, default: 5)
RECORD_INTRA_BATCH_TIMESTAMP_JITTER_NS=5

# Probability [0.0, 1.0] that a record (i > 0) steps backward instead of forward (default: 0.05)
RECORD_INTRA_BATCH_OVERLAP_PROBABILITY=0.05

### LLM traces
# LLM trace knobs (only when OTEL_SIGNAL=traces)
LLM_MAX_TOOL_CALLS=3
LLM_CAPTURE_CONTENT=true
# Relative weights of LLM call forms (name:weight,...). Total must be positive.
LLM_PROFILE_WEIGHTS=simple_chat:1,tool_loop:3,plan_execute_reflect:2,rag:1
# Per-trace span-count budget (signal=traces). Both 0 = disabled (natural per-form shape).
# When enabled (both >= 1, max >= min, max <= 10000), each trace is grown to a random size in
# [min, max]; set min == max for a fixed span count (edge-case testing). Overrides
# LLM_PROFILE_WEIGHTS shape while active.
TRACE_MIN_SPANS=3
TRACE_MAX_SPANS=7


