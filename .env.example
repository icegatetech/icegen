# OTEL Log Generator Configuration

# Telemetry signals to generate, comma-separated (duplicates rejected). List order drives the order
# messages are built, their PRINT_LOGS blocks print, and per-signal stats report; the concurrent
# network sends complete in an unspecified order.
# One message per signal is produced per generation cycle. Examples: logs | traces | logs,traces
OTEL_SIGNALS=logs

CONCURRENCY=1

DRY_RUN=false

# Number of generation cycles to run in batch mode; ignored in continuous mode (default: 1)
# One cycle emits one message per signal in OTEL_SIGNALS, so network requests =
# MESSAGE_COUNT x number of signals (with `logs,traces`, MESSAGE_COUNT=10 sends 20 requests).
MESSAGE_COUNT=10

# Minimum interval between started generation cycles in milliseconds (default: 0)
# A cycle's per-signal messages start together, so this does not space them apart.
# Global in batch mode; applied independently by each worker in continuous mode.
MESSAGE_INTERVAL_MS=100

# Percentage of invalid records to generate 0-100 (default: 0.0)
# Allowed only when OTEL_SIGNALS is exactly `logs`; any traces or multi-signal run must keep this 0
# (an invalid log may omit resourceLogs entirely and cannot be correlated). Otherwise startup fails.
INVALID_RECORD_PERCENT=0.0

# Number of log records per message, spread across the shards below (signal=logs, default: 1)
LOGS_PER_MESSAGE=1

# Number of traces per message, spread across the shards below (signal=traces, default: 1)
# Independent of LOGS_PER_MESSAGE: a shard's log records are split over that shard's traces, so
# each signal's volume scales on its own knob.
TRACES_PER_MESSAGE=1

# Number of service shards (distinct service pods) packed into one request (default: 1)
# Simulates OTEL Collector batching across services/pods. Clamped so no shard of a configured
# signal comes out empty: <= LOGS_PER_MESSAGE for logs, <= TRACES_PER_MESSAGE for traces, and
# <= min(both) when logs and traces run together.
# A shard is one ResourceLogs group for logs and one ResourceSpans group for traces, holding the
# spans of all that shard's traces; when both signals run, a shard's log records are spread across
# its traces' spans.
SERVICE_SHARDS_PER_MESSAGE=1

# Print detailed logs for each message (default: false)
PRINT_LOGS=false

# Run in continuous mode (default: false)
CONTINUOUS_MODE=false

# Retry configuration for rate limiting (HTTP 429 / gRPC ResourceExhausted)
# Maximum number of retry attempts (0-10, default: 3)
RETRY_MAX_RETRIES=3

# Base delay in milliseconds for exponential backoff (default: 1000)
RETRY_BASE_DELAY_MS=1000

# Maximum delay in milliseconds for exponential backoff (default: 32000)
RETRY_MAX_DELAY_MS=32000

# Endpoints — one set per transport flow. Both sets can live here at once: OTEL_TRANSPORT picks the
# flow, and the other flow's variables are simply not read.
# gRPC: a single endpoint carries every signal over distinct OTLP services (LogsService,
#   TraceService), so there is nothing else to set.
OTEL_GRPC_ENDPOINT=http://localhost:4317
# HTTP: one URL per signal. Each selected signal in OTEL_SIGNALS requires its own URL; there is no
#   fallback between them, so a trace request can never reach a /v1/logs path.
OTEL_HTTP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_HTTP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

### Vendor auth (applied to every HTTP/gRPC request, independent of tenant header)
# Raw OTLP headers: key=val,key2=val2  (e.g. Authorization=Bearer xxx, x-bt-parent=project_name:foo)
# OTEL_EXPORTER_OTLP_HEADERS=
# Shortcut: Bearer token -> Authorization: Bearer <token>
# OTEL_AUTH_BEARER=
# Shortcut: user:pass -> base64 -> Authorization: Basic <b64>
# OTEL_AUTH_BASIC=

# Use protobuf encoding (default: false)
OTEL_USE_PROTOBUF=false

# Transport type: http or grpc (default: http)
OTEL_TRANSPORT=http

# Label cardinality limiting. Bounds a log record's own attributes. A shard's whole resource
# attribute set is normalized once whenever logs are configured, and a correlated trace adopts the
# same bucketed values so both signals describe the same pod.
# A traces-only run leaves resource attributes un-normalized.
# Enable/disable limiting (default: true)
OTEL_LABEL_CARDINALITY_ENABLED=true

# Default limit for keys not listed below (optional)
# OTEL_LABEL_CARDINALITY_DEFAULT_LIMIT=32

# Per-key limits as CSV map key=limit,key2=limit2
# Safe defaults are applied automatically for:
# k8s.pod.name=32,host.name=16,service.version=32,request.id=64,thread.id=32,user.id=64
OTEL_LABEL_CARDINALITY_LIMITS=k8s.pod.name=32,host.name=16,service.version=32,request.id=64,thread.id=32,user.id=64

# Tenant routing
# Single-tenant mode defaults to "default".
TENANT_ID=default
# Multi-tenant mode switch. When > 1, routing uses tenant1..tenantN and ignores TENANT_ID.
TENANT_COUNT=1

# Number of cloud.account.id values generated inside each tenant-local pool (default: 4)
CLOUD_ACCOUNT_COUNT_PER_TENANT=4

# Number of service.name values generated inside each tenant-local pool (default: 6)
SERVICE_COUNT_PER_TENANT=6

# Per-batch jitter for log record timestamps in milliseconds; whole request shifts back by rand(0, value).
# Applied once per batch, not per record. (0 to disable, max 3600000, default: 1000 = 1s)
# Correlated runs (OTEL_SIGNALS includes both logs and traces) instead anchor each record to the span
# it belongs to: the offset is capped by that span's window and the result clamped into it, so for
# short spans this jitter has little to no effect.
RECORD_ACROSS_BATCH_TIMESTAMP_JITTER_MS=1000
# Intra-batch forward step between adjacent records and size of rare backward nudge in nanoseconds.
# (0 to disable, max 60000000000, default: 5)
RECORD_INTRA_BATCH_TIMESTAMP_JITTER_NS=5

# Probability [0.0, 1.0] that a record (i > 0) steps backward instead of forward (default: 0.05)
# Correlated runs keep this out-of-order shape: records are merged in time order across the trace's
# spans and the backward nudge is then re-applied, clamped into the window of the record's own span.
RECORD_INTRA_BATCH_OVERLAP_PROBABILITY=0.05

### LLM traces
# LLM trace knobs (apply only when OTEL_SIGNALS includes `traces`)
LLM_MAX_TOOL_CALLS=3
LLM_CAPTURE_CONTENT=true
# Relative weights of LLM call forms (name:weight,...). Total must be positive.
LLM_PROFILE_WEIGHTS=simple_chat:1,tool_loop:3,plan_execute_reflect:2,rag:1
# Per-trace span-count budget (signal=traces). Both 0 = disabled (natural per-form shape).
# When enabled (both >= 1, max >= min, max <= 10000), each trace is grown to a random size in
# [min, max]; set min == max for a fixed span count (edge-case testing). Overrides
# LLM_PROFILE_WEIGHTS shape while active.
TRACE_MIN_SPANS=3
TRACE_MAX_SPANS=7


